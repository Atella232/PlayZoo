# Copia este archivo a apps/web/.env.local y rellénalo para usar el servidor real.
# Sin estas variables la app funciona en "modo demo" (datos locales + jugadores simulados).
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Solo en la app nativa: ID de bloque de anuncios recompensados de AdMob.
# Si no se define se usan los anuncios de prueba de Google.
# VITE_ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
